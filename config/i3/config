# ==========================================
# i3wm Config - Void Linux Theme
# ==========================================

# Основная клавиша модификатора (Mod4 = Super / Windows)
set $mod Mod4

# Шрифт для заголовков окон и статус-бара
font pango:JetBrainsMono Nerd Font 10

# Базовый терминал
set $term kitty

# Скриншот выделенной области в буфер обмена по Win + Shift + S
bindsym $mod+Shift+s exec --no-startup-id maim -s | xclip -selection clipboard -t image/png

# Запуск лаунчера Rofi
set $menu rofi -show drun

# Автозапуск обоев через feh
exec_always --no-startup-id feh --bg-fill /home/rdkgl/wallpaper.png

# --- Управление мышью ---
# Super + ЛКМ перетаскивает плавающее окно
# Super + ПКМ изменяет размер плавающего окна
floating_modifier $mod

# --- Основные горячие клавиши ---

# Открыть терминал (Kitty)
bindsym $mod+Return exec $term
bindsym $mod+t exec $term

# Закрыть активное окно (Super + Q)
bindsym $mod+q kill

# Запуск меню Rofi (Super + D)
bindsym $mod+d exec $menu

# Переключить плавающий режим для окна (Super + Shift + Space)
bindsym $mod+Shift+space floating toggle

# Фокус между тайлингом и плавающими окнами
bindsym $mod+space focus mode_toggle

# --- Перемещение фокуса (vim-стиль + стрелочки) ---
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# --- Перемещение окон ---
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# --- Рабочие столы ---
set $ws1 "1: "
set $ws2 "2: "
set $ws3 "3: "
set $ws4 "4: "
set $ws5 "5: "
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# Переключение рабочих столов
bindsym $mod+1 workspace $ws1
bindsym $mod+2 workspace $ws2
bindsym $mod+3 workspace $ws3
bindsym $mod+4 workspace $ws4
bindsym $mod+5 workspace $ws5
bindsym $mod+6 workspace $ws6
bindsym $mod+7 workspace $ws7
bindsym $mod+8 workspace $ws8
bindsym $mod+9 workspace $ws9
bindsym $mod+0 workspace $ws10

# Перемещение окна на рабочий стол
bindsym $mod+Shift+1 move container to workspace $ws1
bindsym $mod+Shift+2 move container to workspace $ws2
bindsym $mod+Shift+3 move container to workspace $ws3
bindsym $mod+Shift+4 move container to workspace $ws4
bindsym $mod+Shift+5 move container to workspace $ws5
bindsym $mod+Shift+6 move container to workspace $ws6
bindsym $mod+Shift+7 move container to workspace $ws7
bindsym $mod+Shift+8 move container to workspace $ws8
bindsym $mod+Shift+9 move container to workspace $ws9
bindsym $mod+Shift+0 move container to workspace $ws10

# --- Перезагрузка и выход ---
# Перезагрузить конфиг "на лету"
bindsym $mod+Shift+c reload
# Перезапустить i3
bindsym $mod+Shift+r restart
# Выйти из сессии i3
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Выйти из i3?' -B 'Да, выйти' 'i3-msg exit'"

# --- Автозапуск и системные настройки ---

# Отключаем экран ноутбука
exec --no-startup-id xrandr --output LVDS-1 --off

# Раскладка клавиатуры: US + RU по Alt + Shift
exec_always --no-startup-id setxkbmap -layout us,ru -option grp:alt_shift_toggle

# Убираем рамки у окон для чистого вида
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders smart

# Автозапуск Polybar
exec_always --no-startup-id ~/.config/polybar/launch.sh

# --- Цветовая схема в стиле Void Linux (Тёмная + Изумрудный зелёный) ---
# class                 border  backgr. text    indicator child_border
client.focused          #10b981 #10b981 #1b1b1b #10b981   #10b981
client.unfocused        #222222 #141414 #777777 #222222   #141414
client.focused_inactive #2d2d2d #1c1c1c #aaaaaa #2d2d2d   #1c1c1c
client.urgent           #ef4444 #ef4444 #ffffff #ef4444   #ef4444

# Автозапуск агента Polkit
exec --no-startup-id /usr/libexec/polkit-gnome-authentication-agent-1 &
